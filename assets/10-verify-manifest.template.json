{
  "_note": "verify manifest 模板：键 = 任务 id，值 = 该任务的验收断言。复制到项目 70-tools/71-verify-manifest.json（或 paper1 兼容的 scripts/verify_manifest.json）。断言类型见 70-verify.py --schema。示例条目请整体替换。",
  "task-<id>-示例-产物文件": {
    "files": [
      {
        "path": "20-lit/25-citation-audit.md",
        "min_bytes": 9000,
        "contains": ["机制承载核对", "不支持项：0 条", "文本改动留痕"],
        "forbid": ["TODO", "TBD", "AUTHOR CONFIRM"],
        "min_matches": { "pattern": "^\\|\\s*\\d+", "min": 20 }
      },
      {
        "path": "30-manuscript/36-draft.md",
        "min_bytes": 45000,
        "word_count": [7000, 9500],
        "forbid_regex": ["\\bcolor\\b"]
      }
    ]
  },
  "task-<id>-示例-数据与缺席断言": {
    "json_files": [
      {
        "path": "20-lit/22-refs.json",
        "min_items": 20,
        "require_keys_all": ["ref_no", "title", "journal", "year", "doi"]
      }
    ],
    "globs": [
      { "pattern": "40-figures/data/*.pdf", "min_count": 4, "min_bytes_each": 3000 }
    ],
    "absent_paths": ["70-tools/78-scratch/oneoff.py"],
    "run": "python 70-tools/72-assemble-draft.py --check"
  }
}
